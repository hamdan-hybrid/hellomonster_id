# DOMPET USAHA — konfigurasi. Salin ke .env (atau jalankan `npm run init-env`).
NODE_ENV=development
PORT=2026

# Koneksi PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dompet_usaha

# Rahasia (min. 32 karakter acak). JANGAN commit nilai asli.
CSRF_SECRET=
# Pepper PIN kasir. Jika diganti/hilang, semua PIN kasir harus di-reset.
PIN_PEPPER=

# Alamat publik aplikasi (domain saja), mis. https://app.dompetusaha.id — untuk URL absolut di
# tag SEO, gambar pratinjau tautan (WhatsApp/Facebook), dan sitemap.xml. Kosong = URL relatif.
PUBLIC_URL=

# Proxy tepercaya di depan aplikasi: jumlah hop (mis. 1 untuk Nginx), atau "loopback" bila proxy
# berjalan di mesin yang sama (Nginx/Cloudflare Tunnel) — wajib di belakang HTTPS agar cek Origin lolos
# dan IP pengunjung asli terbaca untuk pembatasan login. 0 = akses langsung.
TRUST_PROXY=0

# Cookie hanya lewat HTTPS. Default: true saat NODE_ENV=production.
# COOKIE_SECURE=true

# Batas waktu sesi (detik)
# BO_IDLE_TIMEOUT_SEC=1800
# BO_ABSOLUTE_TIMEOUT_SEC=43200
# BO_REMEMBER_IDLE_SEC=604800
# BO_REMEMBER_ABSOLUTE_SEC=2592000
# POS_IDLE_TIMEOUT_SEC=1800
# POS_ABSOLUTE_TIMEOUT_SEC=50400

# Folder foto produk & foto profil (default: storage/ di folder aplikasi). Wajib ikut di-backup
# bersama database. Contoh production: /var/lib/dompet-usaha/storage
# STORAGE_DIR=

# Zona waktu usaha untuk tanggal dokumen & laporan (default Asia/Jakarta / WIB)
APP_TIMEZONE=Asia/Jakarta
